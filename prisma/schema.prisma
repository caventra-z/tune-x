generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  brand       String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  price       Int
  rmsPower    Int?
  sizeInch    Float?
  sensitivity Int?
  musicTags   String[]
  purpose     String[]
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model Guide {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  coverUrl  String?
  tags      String[]
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PremiumRequest {
  id           String   @id @default(cuid())
  trackingCode String   @unique
  tier         String
  price        Int
  name         String
  phone        String
  email        String?
  carModel     String?
  budget       Int?
  genre        String?
  purpose      String?
  notes        String?
  receiptUrl   String?
  status       String   @default("pending")
  adminNote    String?
  createdAt    DateTime @default(now())
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  name     String?
  password String
  role     String @default("user")
}